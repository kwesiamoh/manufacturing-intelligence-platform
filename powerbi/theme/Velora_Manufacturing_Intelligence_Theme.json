{
  "name": "Velora Beverage Group - Manufacturing Intelligence",
  "dataColors": [
    "#0F766E",
    "#115E59",
    "#16A34A",
    "#D97706",
    "#DC2626",
    "#6B7280",
    "#94A3B8",
    "#0EA5A4"
  ],
  "background": "#F4F6F8",
  "foreground": "#1F2937",
  "tableAccent": "#0F766E",
  "textClasses": {
