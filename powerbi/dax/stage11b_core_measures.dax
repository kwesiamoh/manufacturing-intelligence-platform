// ============================================================
// Stage 11B - core Power BI measures
// Create these in a dedicated Measures table if desired.
// ============================================================

// ---------- Production ----------

Total Planned Units =
SUM('gold.vw_shift_manufacturing_performance'[planned_quantity])

Total Actual Units =
SUM('gold.vw_shift_manufacturing_performance'[actual_quantity])

Total Good Units =
SUM('gold.vw_shift_manufacturing_performance'[good_quantity])

Total Reject Units =
SUM('gold.vw_shift_manufacturing_performance'[reject_quantity])

Production Attainment % =
DIVIDE(
    [Total Actual Units],
    [Total Planned Units]
)

Quality Yield % =
DIVIDE(
    [Total Good Units],
    [Total Actual Units]
)

Reject Rate % =
DIVIDE(
    [Total Reject Units],
    [Total Actual Units]
)

// ---------- OEE components ----------

Availability % =
DIVIDE(
    SUM('gold.vw_shift_manufacturing_performance'[operating_time_min]),
    SUM('gold.vw_shift_manufacturing_performance'[planned_production_time_min])
)

Performance % =
DIVIDE(
    SUM('gold.vw_shift_manufacturing_performance'[actual_quantity]),
    SUMX(
        'gold.vw_shift_manufacturing_performance',
        'gold.vw_shift_manufacturing_performance'[nominal_rate]
            * 'gold.vw_shift_manufacturing_performance'[operating_time_min] / 60.0
    )
)

OEE % =
[Availability %] * [Performance %] * [Quality Yield %]

// ---------- Loss accounting ----------

Planned Downtime Loss Units =
SUM('gold.vw_shift_manufacturing_performance'[planned_downtime_loss_units])

Unplanned Downtime Loss Units =
SUM('gold.vw_shift_manufacturing_performance'[unplanned_downtime_loss_units])

Performance Loss Units =
SUM('gold.vw_shift_manufacturing_performance'[performance_loss_units])

Quality Loss Units =
SUM('gold.vw_shift_manufacturing_performance'[quality_loss_units])

Total Technical Loss Units =
SUM('gold.vw_shift_manufacturing_performance'[total_technical_loss_units])

Technical Opportunity EUR =
SUM('gold.vw_shift_manufacturing_performance'[total_technical_opportunity_eur])

Planned Downtime Opportunity EUR =
SUM('gold.vw_shift_manufacturing_performance'[planned_downtime_opportunity_eur])

Unplanned Downtime Opportunity EUR =
SUM('gold.vw_shift_manufacturing_performance'[unplanned_downtime_opportunity_eur])

Performance Opportunity EUR =
SUM('gold.vw_shift_manufacturing_performance'[performance_opportunity_eur])

Quality Opportunity EUR =
SUM('gold.vw_shift_manufacturing_performance'[quality_opportunity_eur])

// ---------- Energy ----------

Line Electricity kWh =
SUM('gold.vw_shift_manufacturing_performance'[electricity_kwh])

Line Energy Intensity kWh per 1000 Good Units =
DIVIDE(
    [Line Electricity kWh] * 1000.0,
    [Total Good Units]
)

Idle Electricity kWh =
SUM('gold.vw_shift_manufacturing_performance'[line_idle_electricity_kwh])

Idle Energy Share % =
DIVIDE(
    [Idle Electricity kWh],
    SUM('gold.vw_shift_manufacturing_performance'[line_total_electricity_kwh])
)

Compressed Air Nm3 =
SUM('gold.vw_shift_manufacturing_performance'[compressed_air_nm3])

Compressed Air Nm3 per 1000 Units =
DIVIDE(
    [Compressed Air Nm3] * 1000.0,
    [Total Actual Units]
)

// ---------- Executive-site measures ----------

Site Total Energy kWh =
SUM('gold.vw_site_daily_performance'[site_total_electricity_kwh])

Site Energy Intensity kWh per 1000 Units =
DIVIDE(
    [Site Total Energy kWh] * 1000.0,
    SUM('gold.vw_site_daily_performance'[actual_quantity])
)

Benchmark Electricity Cost EUR =
SUM('gold.vw_site_executive_summary'[benchmark_electricity_cost_eur])

Benchmark Electricity Cost EUR per 1000 Units =
DIVIDE(
    [Benchmark Electricity Cost EUR] * 1000.0,
    SUM('gold.vw_site_executive_summary'[energy_production_units])
)

// ---------- Data quality ----------

DQ Evaluated Rows =
SUM('gold.vw_data_quality_domain_summary'[evaluated_rows])

DQ Failed Rows =
SUM('gold.vw_data_quality_domain_summary'[failed_rows])

DQ Score % =
1 - DIVIDE(
    [DQ Failed Rows],
    [DQ Evaluated Rows]
)

DQ Passed Rules =
SUM('gold.vw_data_quality_domain_summary'[passed_rules])

DQ Failed Rules =
SUM('gold.vw_data_quality_domain_summary'[failed_rules])

DQ Warning Rules =
CALCULATE(
    COUNTROWS('gold.vw_data_quality_rule_status'),
    'gold.vw_data_quality_rule_status'[result_status] = "WARN"
)

// ---------- Useful display measures ----------

Selected Site =
SELECTEDVALUE(
    dim_site[site_name],
    "All Sites"
)

Selected Line =
SELECTEDVALUE(
    dim_line[line_name],
    "All Lines"
)
